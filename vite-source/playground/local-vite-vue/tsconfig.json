{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": false,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "vue": ["../../../vue-source/packages/vue/dist/index.d.ts"],
      "@vue-source/*": ["../../../vue-source/packages/*/dist/index.d.ts"]
    }
  },
  "include": [
    "../../../vue-source/packages/external-shims.d.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "src/env.d.ts"
  ]
}
