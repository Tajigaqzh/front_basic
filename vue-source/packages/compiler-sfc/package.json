{
  "name": "@vue-source/compiler-sfc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/compiler-sfc.cjs",
  "module": "./dist/compiler-sfc.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/compiler-sfc.esm.js",
      "require": {
        "production": "./dist/compiler-sfc.cjs.prod",
        "default": "./dist/compiler-sfc.cjs"
      }
    }
  },
  "dependencies": {
    "@vue-source/compiler-core": "workspace:*",
    "@vue-source/compiler-dom": "workspace:*",
    "@vue-source/compiler-ssr": "workspace:*",
    "@vue-source/shared": "workspace:*"
  },
  "scripts": {
    "build": "node ../../scripts/build.js --pkg compiler-sfc && node ../../scripts/build-types.js --pkg compiler-sfc"
  },
  "buildOptions": {
    "formats": ["esm", "cjs", "esm-prod", "cjs-prod"]
  }
}
