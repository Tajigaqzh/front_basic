{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@vue-source/shared": ["../shared/dist/index.d.ts"],
      "@vue-source/reactivity": ["../reactivity/dist/index.d.ts"],
      "@vue-source/runtime-core": ["../runtime-core/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "../global.d.ts", "../external-shims.d.ts"],
  "exclude": ["dist", "../*/dist", "../*/*.d.ts", "../*/*.d.ts.map"]
}
