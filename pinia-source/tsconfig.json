{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": true,
    "paths": {
      "pinia": ["packages/pinia/src"],
      "@pinia/*": ["packages/*/src"]
    },
    "types": ["vitest"]
  },
  "include": [
    "packages/pinia/src/global.d.ts",
    "packages/*/src/**/*.ts",
    "packages/*/__tests__/**/*.ts"
  ]
}
